MYSQL_ROOT_PASSWORD=root_pass
MYSQL_DATABASE=mudanzas_db
MYSQL_USER=mudanzas_user
MYSQL_PASSWORD=mudanzas_pass

# Django. Para producción: una clave larga y secreta, DEBUG en 0 y el dominio o la IP del servidor.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Mapa del recorrido: clave gratuita de https://openrouteservice.org/dev/#/signup (opcional).
ORS_API_KEY=

# Correo de las notificaciones (Gmail): la cuenta y una «contraseña de aplicación» (opcional).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
